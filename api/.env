# ============================================================================
#  UeCampus backend environment (PHP / MySQL)
#  Loaded by api/_db.php. Keep this file SECRET — it is blocked from web
#  access by api/.htaccess. Do not commit real credentials to a public repo.
# ============================================================================

# Database driver: mysql (production) — the backend connects via PDO.
DB_DRIVER=mysql

# MySQL connection. On cPanel/shared hosting the host is almost always
# localhost and the database/user names carry the account prefix.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uecaltyc_website
DB_USER=uecaltyc_website
DB_PASS=Uecampus@online_786
DB_CHARSET=utf8mb4

# Secret used to sign admin login tokens (HMAC). Keep it private; rotating it
# logs everyone out. Generate a new one with: openssl rand -hex 32
APP_SECRET=7fd65045875db3cff4b93c87510686b935e56de257613c7582c0095c9f85021e

# ---------------------------------------------------------------------------
# Outgoing mail (SMTP). Used by api/_mail.php to send lead confirmation
# emails. Port 465 => SMTP_ENCRYPTION=ssl; port 587 => SMTP_ENCRYPTION=tls.
# ---------------------------------------------------------------------------
# uecampus.com mail is hosted on Google Workspace (MX -> aspmx.l.google.com),
# so the enquiry@ mailbox authenticates against Google's SMTP, not against
# mail.uecampus.com (that name is only the web server; it rejects these
# logins with "535 Incorrect authentication data").
#
# Google SMTP does NOT accept the mailbox's normal password. SMTP_PASS must be
# an App Password: Google Admin > Users > enquiry@uecampus.com > Security >
# turn on 2-Step Verification > App passwords > create one for "Mail". Paste
# the 16-character value below. Until then SMTP fails fast and every email
# still goes out through the server's own transport (see SMTP_FALLBACK_LOCAL).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=enquiry@uecampus.com
SMTP_PASS=enquiry@786
SMTP_FROM_EMAIL=enquiry@uecampus.com
SMTP_FROM_NAME="UECampus"
SMTP_ENCRYPTION=ssl
SMTP_TLS_SERVERNAME=smtp.gmail.com
# When SMTP cannot deliver, send through the web server's own mail transport
# (PHP mail() -> Exim). No login needed; the domain's SPF "+a" authorises it.
SMTP_FALLBACK_LOCAL=true

# Email Queue Service Key (for cron-based processing)
EMAIL_SERVICE_KEY=369c205ff75b2c8b0d1ff41d0225f989b094ffe6ed4feddc

# ---------------------------------------------------------------------------
# CRM lead forwarding. Each new enquiry is also POSTed to the CRM REST API
# (see api/submit.php). This is best-effort: a CRM failure never fails the
# user's submission — the lead is always saved locally first.
# ---------------------------------------------------------------------------
CRM_ENDPOINT_URL="https://crm.uecampus.com/api/leads"
CRM_SIGNINS_ENDPOINT_URL="https://crm.uecampus.com/api/signins"
CRM_API_KEY="b34a9e311d7985d636c7435f039a50c419e8a734de37b5bcfed433c6963e8da6"
