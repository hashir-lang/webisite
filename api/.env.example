# Copy to api/.env and fill in your real database credentials.
# api/_db.php reads these to connect via PDO (MySQL).
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4
# Secret for signing admin login tokens. Generate: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# Outgoing mail (SMTP) for lead confirmation emails — see api/_mail.php.
# Port 465 => SMTP_ENCRYPTION=ssl; port 587 => SMTP_ENCRYPTION=tls.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Your Brand"
SMTP_ENCRYPTION=ssl
# Optional. Shared hosts often present a certificate for the machine's own
# name (e.g. business28-3.web-hosting.com) instead of SMTP_HOST. Put that name
# here and the mailer verifies the certificate against it; leave it empty and
# the certificate is not checked. Find it with a reverse DNS lookup of the
# mail server's IP.
SMTP_TLS_SERVERNAME=
# If SMTP cannot deliver (bad password, port blocked), fall back to the web
# server's own transport — PHP mail(), i.e. Exim on cPanel — which needs no
# login. Set to false to make SMTP the only path.
SMTP_FALLBACK_LOCAL=true

# CRM forwarding — api/submit.php (enquiries) and api/contact.php (Contact Us
# messages) POST to CRM_ENDPOINT_URL, and api/signin.php POSTs each popup
# sign-in to CRM_SIGNINS_ENDPOINT_URL. All are best-effort and share the same
# CRM_API_KEY.
CRM_ENDPOINT_URL="https://crm.uecampus.com/api/leads"
CRM_SIGNINS_ENDPOINT_URL="https://crm.uecampus.com/api/signins"
CRM_API_KEY=your_crm_api_key
