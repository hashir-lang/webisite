# ============================================================================
#  UeCampus Blog — per-directory rules for /blog.
#
#  The docroot .htaccess routes every /blog/* URL to /blog/index.php (the
#  server-rendered router) EXCEPT real files (the router, admin.php, uploaded
#  images). This file adds defence-in-depth on top of that:
#    - internal includes (_core.php) can never be fetched directly
#    - the PHP session cookie / auth flow works normally
# ============================================================================

# Internal includes must not be requested directly.
<FilesMatch "^_.*\.php$">
    Require all denied
</FilesMatch>

# Make sure the Authorization header (if ever used) reaches PHP.
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Fallback routing in case this directory is deployed without the docroot rule
# below being present yet: send unknown /blog paths to the PHP router. Real
# files (index.php, admin.php, uploads/*) are served directly.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
